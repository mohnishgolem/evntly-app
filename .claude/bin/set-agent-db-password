#!/bin/bash
# Sets up the password for the evntly_agent_ro database login. Run it yourself
# in a terminal; Claude never sees the password.
#
#   .claude/bin/set-agent-db-password
#
# 1. Generates a strong random password.
# 2. Stores it in your macOS Keychain (service evntly-agent-ro-db), passed to
#    `security` on stdin so it never appears in the process list.
# 3. Prints an ALTER ROLE statement containing only a SCRAM-SHA-256 hash of it.
#    Paste that into the Supabase SQL editor. The plaintext never leaves this Mac
#    and never appears in Supabase's query logs.
#
# Rotate: run it again (the Keychain item is replaced, -U), then paste the new
# statement.
set -euo pipefail
command -v security >/dev/null || { echo "macOS 'security' tool not found" >&2; exit 1; }

PW=$(python3 -I -c 'import secrets; print(secrets.token_urlsafe(32))')
printf 'add-generic-password -U -s evntly-agent-ro-db -a %s -l "Evntly agent read-only DB" -w %s\n' "$USER" "$PW" | security -i >/dev/null
security find-generic-password -s evntly-agent-ro-db -w >/dev/null 2>&1 || { echo "Keychain write failed" >&2; exit 1; }

VERIFIER=$(printf '%s' "$PW" | python3 -I "$(dirname "$0")/scram_verifier.py")
unset PW
echo
echo "Password stored in the Keychain (service evntly-agent-ro-db)."
echo "Paste this into the Supabase SQL editor (project Evntly) and run it:"
echo
echo "  alter role evntly_agent_ro password '$VERIFIER';"
echo
echo "It contains only a one-way hash. Then tell Claude it's done."
